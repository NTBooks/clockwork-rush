<common:LayoutAwarePage
    x:Name="pageRoot"
    x:Class="GearMaker.MainPage"
    DataContext="{Binding DefaultViewModel, RelativeSource={RelativeSource Self}}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GearMaker"
    xmlns:common="using:GearMaker.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Gear="using:GearMaker"
    mc:Ignorable="d" Loaded="pageRoot_Loaded_1" KeyDown="pageRoot_KeyDown_1">

    <Page.Resources>

        <!-- TODO: Delete this line if the key AppName is declared in App.xaml -->
        <x:String x:Key="AppName">Clockwork Rush</x:String>

            <Storyboard x:Name="AnimateRectangle">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Storyboard.TargetName="DrawGear">
                    <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:1" Value="0.4"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:2" Value="0.6"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        <Gear:DivideBy2Converter x:Key="Div2" />

    </Page.Resources>
   
    <!--
        This grid acts as a root panel for the page that defines two rows:
        * Row 0 contains the back button and page title
        * Row 1 contains the rest of the page layout
    -->
    <Grid Style="{StaticResource LayoutRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="140"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--<StackPanel Grid.Row="1" Margin="120,30,0,0">
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="Inner Radius" Grid.Row="0" Grid.Column="0" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="40" Name="InnerRadius" Margin="2,2,2,2" Width="50" />
                <TextBlock Text="Outer Radius" Grid.Row="1" Grid.Column="0" />
                <TextBox Grid.Row="1"  Grid.Column="1" Text="50" Name="OuterRadius" Margin="2,2,2,2" Width="50"   />
                <TextBlock Text="Hole Radius" Grid.Row="2" Grid.Column="0" />
                <TextBox Grid.Row="2" Grid.Column="1"  Text="10" Name="HoleRadius" Margin="2,2,2,2" Width="50"   />
                <TextBlock Text="Teeth" Grid.Row="3" Grid.Column="0" />
                <TextBox  Grid.Row="3" Grid.Column="1"  Text="5" Name="Teeth" Margin="2,2,2,2" Width="50"  />
                <Button  Grid.Row="4" Grid.Column="0"  Name="Quit" Content="Play" Width="100" Click="Quit_Click_1" />
                <Button  Grid.Row="4" Grid.Column="1"  Name="DrawGear" Content="Draw" Width="100" Click="DrawGear_Click_1" />

            </Grid>





            <ItemsControl Name="IC" ItemTemplate="{StaticResource GearViewBox}" />
            <Viewbox  Width="300" Height="300">
                <Viewbox.RenderTransform>
                    <RotateTransform x:Name="TransRotate"
                           CenterX="150" CenterY="150" Angle="0" />
                </Viewbox.RenderTransform>
                <Viewbox.Resources>
                    <Storyboard x:Name="spin">
                        <DoubleAnimation x:Name="da" 
                             Storyboard.TargetName="TransRotate" 
                             Storyboard.TargetProperty="Angle"
                             By="360" 
                             Duration="0:0:10"  
                             AutoReverse="False" 
                             RepeatBehavior="Forever" />
                    </Storyboard>
                </Viewbox.Resources>
                <Viewbox.Clip>
                    <RectangleGeometry Rect="0,0,300,300" />
                </Viewbox.Clip>
                
                <Canvas Width="100" Height="100" Name="DrawSurface">
                   
                    <Path Name="SinglePath" Fill="White" Opacity="0.4">
                        
                    </Path>
                    
                </Canvas>
                
            </Viewbox>
        </StackPanel>-->
        
        <Grid Grid.Row="1" Margin="100,50,100,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Viewbox Grid.Row="0" Grid.Column="0" Grid.RowSpan="2">
            <Grid>
                <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="50" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="70" />
                    <RowDefinition Height="70" />
                    <RowDefinition Height="102" />
                    <RowDefinition Height="70" />
                    <RowDefinition Height="70" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                    <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Button Content="Beginner" Name="D_Beginner" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Click="D_Beginner_Click_1" />
                        <Button Content="Normal" Name="D_Normal" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Click="D_Normal_Click_1" />
                        <Button Content="Expert" Name="D_Expert" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Click="D_Expert_Click_1" />
                        <Button Content="Custom" Name="D_Custom" Grid.Row="0" Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Center"  Click="D_Custom_Click_1"/>
                        
                    </Grid>
                
                
                    <TextBlock Text="Max Rows" Grid.Row="1" Grid.Column="0" Style="{StaticResource TitleTextStyle}" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5,5,5,5"/>
                <Slider Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Foreground="#FF2E87C5" Minimum="10" Maximum="16" Value="10" Name="SliderRow" SnapsTo="Ticks" TickFrequency="2" />

                <TextBlock Text="Columns" Grid.Row="2" Grid.Column="0" Style="{StaticResource TitleTextStyle}" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5,5,5,5"/>
                <Slider Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Foreground="#FF2E87C5"  Minimum="10" Maximum="30" Value="20" Name="SliderCol" SnapsTo="Ticks" TickFrequency="1" />

                <TextBlock Text="Starting Rows" Grid.Row="3" Grid.Column="0" Style="{StaticResource TitleTextStyle}" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5,5,5,5"/>
                <Slider Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Foreground="#FF2E87C5" Minimum="1" Maximum="5" Value="3" Name="SliderStartRows" SnapsTo="Ticks" TickFrequency="1" />

                <TextBlock Text="Max Colors" Grid.Row="4" Grid.Column="0" Style="{StaticResource TitleTextStyle}" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5,5,5,5"/>
                <Slider Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Foreground="#FF2E87C5" Minimum="2" Maximum="4" Value="4"  Name="SliderColors" SnapsTo="Ticks" TickFrequency="1" />

                <TextBlock Text="Speed" Grid.Row="5" Grid.Column="0" Style="{StaticResource TitleTextStyle}" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5,5,5,5"/>
                <Slider Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" Foreground="#FF2E87C5" Minimum="1" Maximum="5" Value="3"  Name="SliderSpeed" SnapsTo="Ticks" TickFrequency="1" />

                <TextBlock Text="Music" Grid.Row="6" Grid.Column="0" Style="{StaticResource TitleTextStyle}" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5,5,5,5"/>
                <Grid Grid.Row="6" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Content="A TYPE" Name="M_ATYPE" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Click="M_ATYPE_Click_1" />
                    <Button Content="B TYPE"  Name="M_BTYPE" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Click="M_BTYPE_Click_1"/>
                    <Button Content="NONE" Name="M_NONE" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Click="M_NONE_Click_1"/>

                </Grid>

                <TextBlock Text="SFX" Grid.Row="7" Grid.Column="0" Style="{StaticResource TitleTextStyle}" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5,5,5,5"/>
                <Grid Grid.Row="7" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                       
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Content="ON" Name="S_ON" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Click="S_ON_Click_1" />

                    <Button Content="OFF" Name="S_OFF" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Click="S_OFF_Click_1"/>

                </Grid>
                
                
                <Button  Grid.Column="0"  Grid.Row="8" Grid.ColumnSpan="2"  Name="Start" Content="Play" HorizontalAlignment="Stretch" Margin="5,5,5,5" Height="90" Click="StartGame" FontSize="48" />
                <Button  Grid.Column="0"  Grid.Row="9" Grid.ColumnSpan="2"  Name="Controls" Click="Controls_Click_1" Content="How to Play" HorizontalAlignment="Stretch" Margin="5,5,5,5" Height="60" FontSize="24" />
                <Button  Grid.Column="0"  Grid.Row="10" Grid.ColumnSpan="2"  Name="ResumeButton"  Content="Resume Game" Click="Resume_Click_1" HorizontalAlignment="Stretch" Margin="5,5,5,5" Height="60" FontSize="24" />
            </Grid>
            </Viewbox>
            <Viewbox  Grid.Row="0" Grid.Column="1" Grid.RowSpan="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="120" />
                    <RowDefinition Height="160" />
                    <RowDefinition Height="300" />
                    <RowDefinition Height="400" />
                </Grid.RowDefinitions>
                <ItemsControl Name="Gear1" Grid.Row="0" HorizontalAlignment="Right" Height="120" Margin="0,0,350,0"/>
                <ItemsControl Name="Gear2" Grid.Row="1" HorizontalAlignment="Right" Height="160" Margin="0,0,350,0"/>
                <ItemsControl Name="Gear3" Grid.Row="2" HorizontalAlignment="Right" Height="300" Margin="0,0,200,0" />
                <ItemsControl Name="Gear4" Grid.Row="3" HorizontalAlignment="Right" Height="400" Margin="0,0,300,0" />
            </Grid>
            </Viewbox>
        </Grid>


        <!-- Back button and page title -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="backButton" Click="GoBack" IsEnabled="{Binding Frame.CanGoBack, ElementName=pageRoot}" Style="{StaticResource BackButtonStyle}"/>
            <TextBlock x:Name="pageTitle" Grid.Column="1" Text="{StaticResource AppName}" Style="{StaticResource PageHeaderTextStyle}"/>
        </Grid>

        <VisualStateManager.VisualStateGroups>

            <!-- Visual states reflect the application's view state -->
            <VisualStateGroup x:Name="ApplicationViewStates">
                <VisualState x:Name="FullScreenLandscape"/>
                <VisualState x:Name="Filled"/>

                <!-- The entire page respects the narrower 100-pixel margin convention for portrait -->
                <VisualState x:Name="FullScreenPortrait">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="backButton" Storyboard.TargetProperty="Style">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PortraitBackButtonStyle}"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

                <!-- The back button and title have different styles when snapped -->
                <VisualState x:Name="Snapped">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="backButton" Storyboard.TargetProperty="Style">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SnappedBackButtonStyle}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="pageTitle" Storyboard.TargetProperty="Style">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SnappedPageHeaderTextStyle}"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</common:LayoutAwarePage>
