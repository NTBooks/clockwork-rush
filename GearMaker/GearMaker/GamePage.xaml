<common:LayoutAwarePage
    x:Name="pageRoot"
    x:Class="GearMaker.GamePage"
    DataContext="{Binding DefaultViewModel, RelativeSource={RelativeSource Self}}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GearMaker"
    xmlns:common="using:GearMaker.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"  Loaded="pageRoot_Loaded_1">

    <Page.Resources>

        <!-- TODO: Delete this line if the key AppName is declared in App.xaml -->
        <x:String x:Key="AppName">Clockwork Rush</x:String>
    </Page.Resources>

    <!--
        This grid acts as a root panel for the page that defines two rows:
        * Row 0 contains the back button and page title
        * Row 1 contains the rest of the page layout
    -->
    
    <Grid Style="{StaticResource LayoutRootStyle}" KeyDown="pageRoot_KeyDown_1">
        <Grid.RowDefinitions>
            <RowDefinition Height="140"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Back button and page title -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="backButton" Click="GoBack" IsEnabled="{Binding Frame.CanGoBack, ElementName=pageRoot}" Style="{StaticResource BackButtonStyle}"/>
            <TextBlock x:Name="pageTitle" Grid.Column="1" Text="{StaticResource AppName}" Style="{StaticResource PageHeaderTextStyle}"/>
            <Viewbox Grid.Column="2"><TextBlock Name="currentScore" Margin="20,5,5,5" /></Viewbox>
            <Viewbox Grid.Column="3"  VerticalAlignment="Center" Margin="0,0,20,0" Name="Pause" Opacity="0.5" PointerPressed="Pause_PointerPressed_1">
                <Grid>
                    <Path Data="M43.5,5.28287 L43.9194,5.5736 C50.928,10.5577 55.5,18.7449 55.5,28 C55.5,37.2551 50.928,45.4423 43.9194,50.4264 L43.5,50.7171 z M12.5,5.28287 L12.5,50.7171 L12.0806,50.4264 C5.07197,45.4423 0.499999,37.2551 0.5,28 C0.499999,18.7449 5.07197,10.5577 12.0806,5.5736 z M28,0.5 C29.4239,0.5 30.8224,0.608212 32.188,0.816862 L32.5,0.868558 L32.5,55.1314 L32.188,55.1831 C30.8224,55.3918 29.4239,55.5 28,55.5 C26.5761,55.5 25.1776,55.3918 23.812,55.1831 L23.5,55.1314 L23.5,0.868558 L23.812,0.816862 C25.1776,0.608212 26.5761,0.5 28,0.5 z" Fill="#66F4F4F5" HorizontalAlignment="Right" Height="56" Margin="0,1,0,0" Stretch="Fill" Stroke="Black" UseLayoutRounding="False" VerticalAlignment="Top" Width="56" StrokeThickness="0"/>
                    <Rectangle Fill="#CCF4F4F5" HorizontalAlignment="Left" Height="60" Margin="11,0,0,0" Stroke="#7F000000" VerticalAlignment="Top" Width="14" RenderTransformOrigin="0.5,0.5" StrokeThickness="3">
                        <Rectangle.RenderTransform>
                            <CompositeTransform ScaleX="-1"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Fill="#CCF4F4F5" HorizontalAlignment="Left" Height="60" Margin="31,0,0,0" Stroke="#7F000000" VerticalAlignment="Top" Width="14" RenderTransformOrigin="0.5,0.5" StrokeThickness="3">
                        <Rectangle.RenderTransform>
                            <CompositeTransform ScaleX="-1"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
            </Viewbox>
        </Grid>

        <Viewbox Grid.Row="1" Margin="5,5,5,5">
        <Grid  VerticalAlignment="Center" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                
            </Grid.RowDefinitions>
          

            <Canvas Grid.Row="0" Grid.Column="1" Name="GameBoardBackground">


            </Canvas>

            <Canvas Grid.Row="0" Grid.Column="1" Name="GameBoard"  PointerPressed="GameBoard_PointerPressed_1" PointerReleased="GameBoard_PointerReleased_1">


            </Canvas>

            <Viewbox Grid.Row="0" Grid.Column="0" Width="80" PointerPressed="Viewbox_PointerPressed_2" Opacity="0.5" Name="RotateR" HorizontalAlignment="Left">
                <Grid>
                    <Path Data="M56.6979,0.5 C84.8857,0.500002 108.227,21.1504 112.274,48.0768 L112.434,49.2328 L84.7728,49.2328 L121.469,108.699 L120.664,109.693 C105.349,128.139 82.1716,139.897 56.2315,139.897 L56.2176,139.897 L56.2176,112.326 L53.8054,112.266 C24.1118,110.768 0.499998,86.3373 0.5,56.4191 C0.499998,25.5359 25.6603,0.500002 56.6979,0.5 z" Fill="#66F4F4F5" HorizontalAlignment="Left" Height="140.397" Margin="46.769,45.603,0,0" Stretch="Fill" Stroke="Black" UseLayoutRounding="False" VerticalAlignment="Top" Width="121.969"/>
                    <Path Data="M127.203,0.5 C183.536,0.499999 229.203,46.167 229.203,102.5 C229.203,158.833 183.536,204.5 127.203,204.5 L127.203,160.487 L129.714,160.424 C160.624,158.857 185.203,133.299 185.203,102 C185.203,69.6914 159.012,43.5 126.703,43.5 C97.3605,43.5 73.0635,65.1035 68.85,93.2727 L68.6841,94.482 L97.478,94.482 L48.989,173.45 L0.5,94.482 L25.5167,94.482 L25.7178,92.1916 C30.8855,40.6998 74.3498,0.499999 127.203,0.5 z" Fill="#C9F4F4F5" HorizontalAlignment="Left" Height="205" Stretch="Fill" Stroke="Black" UseLayoutRounding="False" VerticalAlignment="Top" Width="229.703" RenderTransformOrigin="0.5,0.5" StrokeThickness="10">
                        <Path.RenderTransform>
                            <CompositeTransform ScaleX="-1"/>
                        </Path.RenderTransform>
                    </Path>
                </Grid>
            </Viewbox>



                <Viewbox Grid.Row="0" Grid.Column="2" Width="80" PointerPressed="Viewbox_PointerPressed_1"  Opacity="0.5" Name="RotateQ" HorizontalAlignment="Right">
                <Grid>
                    <Path Data="M56.6979,0.5 C84.8857,0.500002 108.227,21.1504 112.274,48.0768 L112.434,49.2328 L84.7728,49.2328 L121.469,108.699 L120.664,109.693 C105.349,128.139 82.1716,139.897 56.2315,139.897 L56.2176,139.897 L56.2176,112.326 L53.8054,112.266 C24.1118,110.768 0.499998,86.3373 0.5,56.4191 C0.499998,25.5359 25.6603,0.500002 56.6979,0.5 z" Fill="#66F4F4F5" HorizontalAlignment="Left" Height="140.397" Margin="60.619,45.603,0,0" Stretch="Fill" Stroke="Black" UseLayoutRounding="False" VerticalAlignment="Top" Width="121.969" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <CompositeTransform ScaleX="-1"/>
                        </Path.RenderTransform>
                    </Path>
                    <Path Data="M127.203,0.5 C183.536,0.499999 229.203,46.167 229.203,102.5 C229.203,158.833 183.536,204.5 127.203,204.5 L127.203,160.487 L129.714,160.424 C160.624,158.857 185.203,133.299 185.203,102 C185.203,69.6914 159.012,43.5 126.703,43.5 C97.3605,43.5 73.0635,65.1035 68.85,93.2727 L68.6841,94.482 L97.478,94.482 L48.989,173.45 L0.5,94.482 L25.5167,94.482 L25.7178,92.1916 C30.8855,40.6998 74.3498,0.499999 127.203,0.5 z" Fill="#C9F4F4F5" HorizontalAlignment="Left" Height="205" Stretch="Fill" Stroke="Black" UseLayoutRounding="False" VerticalAlignment="Top" Width="229.703" RenderTransformOrigin="0.5,0.5" StrokeThickness="10">
                        <Path.RenderTransform>
                            <CompositeTransform/>
                        </Path.RenderTransform>
                    </Path>
                </Grid>
            </Viewbox>

               

            </Grid>
        </Viewbox>

        <VisualStateManager.VisualStateGroups>

            <!-- Visual states reflect the application's view state -->
            <VisualStateGroup x:Name="ApplicationViewStates">
                <VisualState x:Name="FullScreenLandscape"/>
                <VisualState x:Name="Filled"/>

                <!-- The entire page respects the narrower 100-pixel margin convention for portrait -->
                <VisualState x:Name="FullScreenPortrait">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="backButton" Storyboard.TargetProperty="Style">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PortraitBackButtonStyle}"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

                <!-- The back button and title have different styles when snapped -->
                <VisualState x:Name="Snapped">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="backButton" Storyboard.TargetProperty="Style">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SnappedBackButtonStyle}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="pageTitle" Storyboard.TargetProperty="Style">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SnappedPageHeaderTextStyle}"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</common:LayoutAwarePage>
